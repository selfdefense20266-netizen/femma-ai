EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat SDK public keys (safe to expose client-side, unlike secret API keys).
# Development: use your RevenueCat "Test Store" public key (starts with test_).
# Production: use your real Android public key from RevenueCat (starts with goog_).
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_key

# Optional cross-platform fallback / iOS key, used when the Android-specific key above is not set.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_your_test_store_key

# Optional: live web GIF search for moves ExerciseDB misses (breath, sun salutation, …)
# Get a free key at https://developers.giphy.com/
# EXPO_PUBLIC_GIPHY_API_KEY=
