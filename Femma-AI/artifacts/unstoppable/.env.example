EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Social login (configure in Supabase Dashboard → Authentication → Providers)
# Google: Web OAuth Client ID + Secret from Google Cloud Console → paste into Supabase Google provider.
# Apple: enable Sign in with Apple on App ID femmi.app; in Supabase Client IDs add femmi.app
# Redirect URLs (Supabase Auth → URL Configuration):
#   femmaai://auth/callback
#   https://YOUR_PROJECT.supabase.co/auth/v1/callback
# Paste the Supabase callback URL into Google Cloud → OAuth client → Authorized redirect URIs.

# Native Google Sign-In (Android / iOS): Google's own account sheet showing the app name, no browser redirect.
# Google Cloud Console -> APIs & Services -> Credentials:
#   1. Web client ID  -> also paste it in Supabase -> Auth -> Providers -> Google -> "Client IDs"
#   2. Android client -> package name femmi.app + SHA-1 of BOTH the upload key and Play "App signing" key
#   3. iOS client     -> bundle ID femmi.app (only needed for an iOS build)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat SDK public keys (safe to expose client-side, unlike secret API keys).
# Development: use your RevenueCat "Test Store" public key (starts with test_).
# Production: use your real Android public key from RevenueCat (starts with goog_).
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_key

# Optional cross-platform fallback / iOS key, used when the Android-specific key above is not set.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_your_test_store_key

# Optional: live web GIF search for moves ExerciseDB misses (breath, sun salutation, …)
# Get a free key at https://developers.giphy.com/
# EXPO_PUBLIC_GIPHY_API_KEY=
